# 项目内技能入口：软链接是种文件形式, 所以最后不要加 ‘ / ’
/.dsh/skills/dsh-agent-init

# ───────────────────────────── 第三方参考资料 ─────────────────────────────
# reference/ 是已淘汰项目的存档：234 个文件，含 2.9 MB 的 onnx 与完整的
# YOLOv5Lite 源码，并带有自己的 LICENSE。它只是查阅对象与工具链依据，
# 不属于本仓库源码，故不纳入版本控制。
/reference/

# ─────────────────────────────── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ─────────────────────────────── 运行产物 ────────────────────────────────
# 标定记录、落盘原始帧、掩膜、状态机轨迹、三道闸逐条判定日志。
# 这些是排查的唯一证据，但它们是现场数据而不是源码，不入库。
/artefacts/
/runs/
/logs/
*.log

# ────────────────────────── 大文件：权重与录像 ───────────────────────────
# 需要版本化时改用 Git LFS，或随发布单独分发。
*.onnx
*.pt
*.pth
*.engine
*.mp4
*.avi
*.mov
*.mkv

# ─────────────────────────────── 凭据 ────────────────────────────────────
.env
.env.*
!.env.example
*credentials*
*.pem
*.key

# ─────────────────────────── 编辑器 / 操作系统 ───────────────────────────
# 若队里想共享 launch.json / settings.json，在下面加 ! 例外。
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
